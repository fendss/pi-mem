{
  "name": "pi-mem",
  "version": "1.0.0",
  "private": true,
  "description": "A minimal, source-grounded memory agent runtime built on Pi.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fendss/pi-mem.git"
  },
  "homepage": "https://github.com/fendss/pi-mem#readme",
  "bugs": {
    "url": "https://github.com/fendss/pi-mem/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:python": "python3 -m unittest scripts/test_longmemeval_frozen_eval.py",
    "check": "npm run typecheck && npm test -- --maxWorkers=4 && npm run test:python && npm run build",
    "cli": "node --disable-warning=ExperimentalWarning dist/cli.js"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.82.1",
    "@earendil-works/pi-ai": "0.82.1",
    "typebox": "1.3.8"
  },
  "devDependencies": {
    "@types/node": "24.10.1",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  }
}
